namespace ZBench;

extern "C" {
    fn puts(s: str) -> i32;
}

fn work(n: i32) -> i32 {
    let i: i32 = 0;
    let acc: i32 = 0;
    while (i < n) {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

fn main() -> i32
{
    puts("zbench (Z# micro-benchmark)");
    let r1: i32 = work(1000);
    let r2: i32 = work(10000);
    puts("work(1000) and work(10000) computed in Z#");
    return r1 + r2;
}
