namespace ZCalc;

extern "C" {
    fn puts(s: str) -> i32;
}

fn add(a: i32, b: i32) -> i32 { return a + b; }
fn sub(a: i32, b: i32) -> i32 { return a - b; }
fn mul(a: i32, b: i32) -> i32 { return a * b; }
fn divi(a: i32, b: i32) -> i32 {
    if (b == 0) { return 0; }
    return a / b;
}

fn main() -> i32
{
    let a: i32 = 42;
    let b: i32 = 7;
    let s: i32 = add(a, b);
    let d: i32 = sub(a, b);
    let m: i32 = mul(a, b);
    let q: i32 = divi(a, b);
    puts("zcalc (Z#): computed 42,7 -> sum,diff,prod,quot");
    // results computed in Z# (s=49,d=35,m=294,q=6)
    return s + d + m + q;
}
